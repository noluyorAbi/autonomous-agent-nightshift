{
  // Markdownlint config — pragmatic rules. We catch real correctness/clarity
  // issues; we don't gate-keep pure formatting style (spacing around headings,
  // blank lines around lists). Editors handle that.
  "config": {
    "default": true,
    // Line length: docs are prose-heavy, no hard wrap
    "MD013": false,
    // Blank lines around headings — pure style
    "MD022": false,
    // Duplicate headings — CHANGELOG has H2 per version under same parent
    "MD024": false,
    // Multiple H1s allowed
    "MD025": false,
    // Trailing punctuation in headings ("Cost & safety")
    "MD026": false,
    // Blank lines around lists — pure style
    "MD032": false,
    // Blank lines around fenced code blocks — pure style
    "MD031": false,
    // Spaces in code spans — intentional in templates/todo-template.md where
    // we document literal strings the runner appends (`` ` — NEEDS MANUAL REVIEW` ``)
    "MD038": false,
    // Link fragments — playbook has hand-written anchor links that work on
    // GitHub's auto-anchor generation but trip strict validators
    "MD051": false,
    // Inline HTML — README uses <details>, <table>, <kbd>, etc.
    "MD033": false,
    // Bare URLs — less noise in install/cost docs
    "MD034": false,
    // Code blocks without language — sometimes intentional (raw output)
    "MD040": false,
    // First line doesn't need top-level heading
    "MD041": false,
    // Table column style — pipe spacing is editor-territory
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "site/node_modules", "site/dist", "examples"]
}
