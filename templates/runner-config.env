# =========================================================================
# Tuning presets for run-agent-loop.sh and nightshift-bulletproof.sh
# =========================================================================
# Paste the chunk for your scenario into the CONFIG section of the script.
# Formula: MAX_ITERATIONS >= NUM_TASKS × (1 + MAX_FIX_ATTEMPTS + 2)

# --- Fast prototype: 5 easy tasks, don't care about edge cases ---
MAX_ITERATIONS=50
MAX_FIX_ATTEMPTS=3
MAX_CHROME_FIX_ATTEMPTS=2
COOLDOWN_SECONDS=2

# --- Default nightshift: 10-20 mixed tasks ---
MAX_ITERATIONS=200
MAX_FIX_ATTEMPTS=7
MAX_CHROME_FIX_ATTEMPTS=3
COOLDOWN_SECONDS=5

# --- Marathon: 30+ ambitious tasks, expect some failures ---
MAX_ITERATIONS=400
MAX_FIX_ATTEMPTS=10
MAX_CHROME_FIX_ATTEMPTS=4
COOLDOWN_SECONDS=8

# --- Bulletproof production sweep: 100 hardening steps ---
MAX_ITERATIONS=500
MAX_FIX_ATTEMPTS=7
MAX_CHROME_FIX_ATTEMPTS=3
COOLDOWN_SECONDS=5
COOLDOWN_MAX=120
